    {
      "id": "4v8Zd0aE",
      "type": "text",
      "x": 28.919137421994606,
      "y": 87.84269737562454,
      "width": 277.3556213378906,
      "height": 135,
      "angle": 0,
      "strokeColor": "#2f9e44",
