      "version": 145,
      "versionNonce": 1308101966,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790748437963,
      "locked": false,
      "text": "USDC\n   │\n   │ approve(∞) — one time\n   ↓\nPermit2\n   │\n   ├── App A → 100 USDC, expires tomorrow\n   ├── App B → 50 USDC, expires next week\n   └── App C → one-time 20 USDC transfer",
      "rawText": "USDC\n   │\n   │ approve(∞) — one time\n   ↓\nPermit2\n   │\n   ├── App A → 100 USDC, expires tomorrow\n   ├── App B → 50 USDC, expires next week\n   └── App C → one-time 20 USDC transfer",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "USDC\n   │\n   │ approve(∞) — one time\n   ↓\nPermit2\n   │\n   ├── App A → 100 USDC, expires tomorrow\n   ├── App B → 50 USDC, expires next week\n   └── App C → one-time 20 USDC transfer",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "hasTextLink": false,
      "link": null
    },
