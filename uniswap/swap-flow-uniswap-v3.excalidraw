      "isDeleted": false,
      "boundElements": [],
      "updated": 1788759748295,
      "locked": false,
      "text": "1)\n- yes! Better for security\n\n- Pool holds no allowances,\nbut risks moved to Callback\n\n- \"pulling\" property is not\ntheir problem",
      "rawText": "1)\n- yes! Better for security\n\n- Pool holds no allowances,\nbut risks moved to Callback\n\n- \"pulling\" property is not\ntheir problem",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1)\n- yes! Better for security\n\n- Pool holds no allowances,\nbut risks moved to Callback\n\n- \"pulling\" property is not\ntheir problem",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false,
      "link": null
    },
