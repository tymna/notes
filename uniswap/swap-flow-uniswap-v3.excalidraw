      "isDeleted": false,
      "boundElements": [],
      "updated": 1788759748295,
      "locked": false,
      "text": "2)\n    - only one approve for Router\n    (pool just checks if balance arrived =>\n    any payment source)\n\n    - every swap is mechanically a flash swap\n    (3 step process)",
      "rawText": "2)\n    - only one approve for Router\n    (pool just checks if balance arrived =>\n    any payment source)\n\n    - every swap is mechanically a flash swap\n    (3 step process)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2)\n    - only one approve for Router\n    (pool just checks if balance arrived =>\n    any payment source)\n\n    - every swap is mechanically a flash swap\n    (3 step process)",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false,
      "link": null
    },
    {
      "id": "fzF1eF7r",
