    {
      "id": "eAuLwM97",
      "type": "text",
      "x": -210.91093122689017,
      "y": -31.809537063638345,
      "width": 744.7595825195312,
      "height": 700,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aa",
      "roundness": null,
      "seed": 157138771,
      "version": 105,
      "versionNonce": 741235165,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791964675328,
      "locked": false,
      "text": "upload Solidity project\n        |\n        v\nFastAPI backend          1. POST /v1/jobs/start → saves job in Postgres,\n        |                   stores zip + API key in Secrets Service\n        v\nJob queue (RabbitMQ)     2. holds the job message\n        |\n        v\nInstancer                3. picks up the message, starts one container per job\n        |\n        v\nworker container         4. fetches bundle → unzips contracts to audit/\n        |                   → copies detect.md to AGENTS.md\n        v\nCodex agent              5. reads AGENTS.md, audits audit/ (max 3h)\n        |\n        v\nsubmission/audit.md      6. findings as JSON {\"vulnerabilities\": [...]}\n        |\n        v\nworker check             7. \"is it valid JSON?\" → upload\n        |\n        v\nResults Service          8. parses again → saves to Postgres\n        |\n        v\nVulnerability report     9. frontend polls status → renders JSON as report",
      "rawText": "upload Solidity project\n        |\n        v\nFastAPI backend          1. POST /v1/jobs/start → saves job in Postgres,\n        |                   stores zip + API key in Secrets Service\n        v\nJob queue (RabbitMQ)     2. holds the job message\n        |\n        v\nInstancer                3. picks up the message, starts one container per job\n        |\n        v\nworker container         4. fetches bundle → unzips contracts to audit/\n        |                   → copies detect.md to AGENTS.md\n        v\nCodex agent              5. reads AGENTS.md, audits audit/ (max 3h)\n        |\n        v\nsubmission/audit.md      6. findings as JSON {\"vulnerabilities\": [...]}\n        |\n        v\nworker check             7. \"is it valid JSON?\" → upload\n        |\n        v\nResults Service          8. parses again → saves to Postgres\n        |\n        v\nVulnerability report     9. frontend polls status → renders JSON as report",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "upload Solidity project\n        |\n        v\nFastAPI backend          1. POST /v1/jobs/start → saves job in Postgres,\n        |                   stores zip + API key in Secrets Service\n        v\nJob queue (RabbitMQ)     2. holds the job message\n        |\n        v\nInstancer                3. picks up the message, starts one container per job\n        |\n        v\nworker container         4. fetches bundle → unzips contracts to audit/\n        |                   → copies detect.md to AGENTS.md\n        v\nCodex agent              5. reads AGENTS.md, audits audit/ (max 3h)\n        |\n        v\nsubmission/audit.md      6. findings as JSON {\"vulnerabilities\": [...]}\n        |\n        v\nworker check             7. \"is it valid JSON?\" → upload\n        |\n        v\nResults Service          8. parses again → saves to Postgres\n        |\n        v\nVulnerability report     9. frontend polls status → renders JSON as report",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "hasTextLink": false
    },
